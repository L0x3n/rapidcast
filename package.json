{
  "name": "rapidcast",
  "version": "1.0.0",
  "description": "An AI-native Twitch studio where chat helps build the stream.",
  "private": true,
  "license": "MIT",
  "author": "Linus",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run build:overlay && electron-vite dev",
    "start": "npm run build:overlay && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run build:overlay && electron-vite build",
    "build:overlay": "vite build --config overlay.vite.config.mts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:engine": "node scripts/smoke.mjs --engine",
    "smoke:widgets": "node scripts/smoke.mjs --widgets",
    "smoke:ai": "node scripts/smoke.mjs --ai",
    "smoke:setup": "node scripts/smoke.mjs --setup",
    "smoke:stats": "node scripts/smoke.mjs --stats",
    "smoke:stats:long": "node scripts/smoke.mjs --stats-long",
    "smoke:packs": "node scripts/check-packs.mjs",
    "check:rtmp": "node scripts/check-rtmp.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "package:win": "node scripts/package-win.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "check:clean-clone": "node scripts/check-clean-clone.mjs"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "chart.js": "4.6.1",
    "ffmpeg-static": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
